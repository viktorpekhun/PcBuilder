{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowMinutes": 1,
      "QueueLimit": 0
    },
    "Scraper": {
      "PermitLimit": 20,
      "WindowMinutes": 1,
      "QueueLimit": 0
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
    { "Name": "Console" },
    {
      "Name": "File",
      "Args": {
        "path": "Logs/log-.txt",
        "rollingInterval": "Day",
        "retainedFileCountLimit": 14
      }
    },
    {
      "Name": "Seq",
      "Args": {
        "serverUrl": "http://localhost:5341",
        "apiKey": "" 
      }
    }
  ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
},
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=PcBuilder;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "",
    "Audience": "",
    "ExpirationInMinutes": "",
    "ExpirationInDays": ""
  },
  "AzureTranslator": {
    "Endpoint": "https://api.cognitive.microsofttranslator.com/",
    "Key": "",
    "Region": ""
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest"
  },
  "Google": {
    "ClientId": ""
  },
  "Email": {
    "FromAddress": "noreply@pcbuilder.com",
    "FrontendUrl": "http://localhost:5173",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": ""
    }
  },
  "AdminSeed": {
    "Email": "",
    "Username": "",
    "Password": ""
  },
  "Files": {
    "AvatarDirectory": "wwwroot/avatars"
  },
  "TextModeration": {
    "BaseUrl": "http://localhost:8001"
  },
  "PassMark": {
    "UpdateIntervalDays": 7,
    "MinMatchScore": 80
  },
  "AzureStorage": {
    "ConnectionString": "",
    "ContainerName": "component-images"
  }
}
